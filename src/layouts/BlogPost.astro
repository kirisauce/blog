---
import PostContent from '../components/PostContent.astro';
import AuthorCard from '../components/Cards/AuthorCard.astro';
import TocCard from '../components/Cards/TocCard.astro';
import BasicLayout from './BasicLayout.astro';
import Icon from '../components/Icon.astro';
import MenuButton from '../components/NavBar/MenuButton.svelte';
import TocDrawer from '../components/NavBar/TocDrawer.svelte';

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { author as authorConfig } from '../config';
import { fade } from 'astro:transitions';
import { m3anim } from '../utils/consts';
import BlogPosting from '../components/json-ld/BlogPosting.astro';

export type Props = {
  post: CollectionEntry<'blog'>;
};

const { coverImage, author: postAuthor, title } = Astro.props.post.data;

const author = postAuthor ?? authorConfig.defaultAuthor;

const { headings } = await render(Astro.props.post);

const layoutProps = {
  coverImage,
  head: {
    titleText: title,
    type: 'article',
    post: Astro.props.post,
  },
} satisfies Parameters<typeof BasicLayout>[0];
---

<BasicLayout {...layoutProps}>
  <Fragment slot="head-extra">
    <BlogPosting post={Astro.props.post} />
  </Fragment>

  <Fragment slot="right-extra">
    {
      headings.length > 0 && (
        <MenuButton client:only target="#toc-drawer">
          <Icon src="mingcute:menu-fill" />
        </MenuButton>
      )
    }
  </Fragment>

  <Fragment slot="nav-extra">
    {headings.length > 0 && <TocDrawer headings={headings} client:load />}
  </Fragment>

  <Fragment slot="major">
    <main
      transition:animate={fade({
        duration: m3anim.standardDefaultSpatial.duration,
      })}
      class="card article-content-card"
      data-enter-item
    >
      <PostContent post={Astro.props.post} />
    </main>
  </Fragment>

  <Fragment slot="aside">
    {author && <AuthorCard transition:name="author-card" authorId={author} />}
    <TocCard {headings} />
  </Fragment>
</BasicLayout>

<style lang="stylus">
  :global(.page:has(.cover-image) .article-content-card) {
    margin-top: calc(-1.5rem - 64px);
  }

  :global(.page aside) {
    gap: 32px;
  }

  .article-content-card {
    box-sizing: border-box;
    width: 100%;
    padding: 32px;

    @media (max-width: 1024px) {
      padding: 20px 16px;
    }
  }

  // <1640px 文章底部不再显示 TOC（由顶部抽屉接管，避免重复）；
  // ≥1640px 侧边栏 TOC 保留。布局决策，写在文章页而非 TocCard 内。
  :global(.page .toc-card) {
    @media (max-width: 1639px) {
      display: none;
    }
  }
</style>
