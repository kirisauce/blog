hue = var(--color-hue, 0)
redhue = 25
selectionhue = "calc(%s + 45)" % hue

palette = {
  surface-hover: oklch(92% 1% hue)   oklch(24% 1% hue)
  primary:    oklch(58% 22% hue)     oklch(72% 20% hue)
  secondary:  oklch(55% 18% hue)     oklch(68% 16% hue)
  background: oklch(99% 0.5% hue)    oklch(11% 1% hue)
  surface:    oklch(97% 0.8% hue)    oklch(16% 1% hue)
  border:     oklch(90% 1% hue)      oklch(28% 1.5% hue)
  text:       oklch(25% 1.5% hue)    oklch(93% 1% hue)
  text-muted: oklch(45% 2% hue)      oklch(72% 1.5% hue)
  nav:        oklch(98% 0.6% hue)    oklch(14% 1% hue)

  primary-container:    oklch(93% 3% hue)   oklch(26% 4% hue)
  on-primary-container: oklch(35% 20% hue)  oklch(90% 12% hue)
  secondary-container:  oklch(92% 3% hue)   oklch(22% 3.5% hue)
  on-secondary-container: oklch(35% 20% hue) oklch(88% 10% hue)
  surface-container:    oklch(96% 0.8% hue) oklch(20% 1% hue)
  on-surface-container: oklch(25% 1.5% hue) oklch(92% 1% hue)
  container:            oklch(99% 0.3% hue) oklch(13% 0.8% hue)
  on-container:         oklch(25% 1.5% hue) oklch(92% 1% hue)

  error:            oklch(55% 18% redhue) oklch(70% 16% redhue)
  error-container:  oklch(93% 3% redhue)  oklch(28% 6% redhue)
  on-error:         oklch(100% 0% redhue) oklch(0% 0% redhue)
  on-error-container: oklch(35% 14% redhue) oklch(92% 6% redhue)

  selection-text:       oklch(45% 12% selectionhue) oklch(85% 10% selectionhue)
  selection-background: oklch(90% 6% selectionhue)  oklch(32% 10% selectionhue)

  shadow: oklch(0% 0% hue \/ 0.08) oklch(0% 0% hue \/ 0.3)

  meta-bg: oklch(94% 1% hue \/ 0.5) oklch(26% 2% hue \/ 0.4)
}