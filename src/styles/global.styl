code
  font-family: var(--font-monospace)

a.nodefault
  text-decoration: none
  color: inherit

.card
  background-color: var(--surface)
  border: 1px solid var(--border)
  border-radius: 20px
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -2px rgba(0, 0, 0, 0.1)
  padding: 1.5rem

.padded-icon-svg
  font-size: 24px;

body::selection
  color: var(--selection-text)
  background-color: var(--selection-background)

@keyframes dropdown
  0%
    transform: translate(0, 0)
    opacity: 1
  100%
    transform: translate(0, 64px)
    opacity: 0

// 静态框架元素（navbar、aside 卡片等）在页面切换时保持原位，
// 以与封面一致的节奏淡入淡出（时长来自预定义动画变量）
::view-transition-group(*)
  animation-duration: var(--standard-default-spatial-duration)
  z-index: 2000

// 封面放大是页面切换的主角：弹性曲线 + 预定义时长
::view-transition-group(clicked-cover)
  animation-duration: var(--expressive-default-spatial-duration)
  z-index: 100

// 标题/分类跟随封面过渡，与封面同节奏
::view-transition-group(clicked-title),
::view-transition-group(clicked-category)
  animation-duration: var(--standard-default-spatial-duration)
  z-index: 2001

::view-transition-old(clicked-title)
  height: 100%;
  width: auto;

.cover-image::view-transition-old(clicked-cover)
  height: 100%

::view-transition-old(clicked-cover),
::view-transition-new(clicked-cover)
  height: 100%

::view-transition-group(root),
::view-transition-group(basic-layout-html)
  z-index: -1000

::view-transition-group(nav-panel-color-scheme),
::view-transition-group(nav-panel-theme-color)
  z-index: 2100

::view-transition-group(loading-indicator)
  z-index: 2200

::view-transition-group(home-links)
  z-index: -100

// 内容区块间距优化
.article-content-card {
  .markdown {
    // 移除多余的间距规则，交由 common.styl 统一管理
  }
}
