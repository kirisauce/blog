---
import type { CollectionEntry } from 'astro:content';
import { blogurl } from '../../utils/url';
import { generateId } from '../../utils/other';
import { Image } from 'astro:assets';
import CategoryBreadcrumb from '../MetaWidgets/CategoryBreadcrumb.astro';
import Label from '../Label.astro';
import TimeMeta from '../MetaWidgets/TimeMeta.astro';
import TagsMeta from '../MetaWidgets/TagsMeta.astro';
import { resolveDisplayDate } from '../../utils/format';

export interface Props {
  post: CollectionEntry<'blog'>;
  updateDate?: Date;
  pubDate?: Date;
  description?: string;
}

const { post, updateDate, pubDate, description } = Astro.props;
const { category, tags } = post.data;

const { time: displayDate, updated } = resolveDisplayDate(pubDate, updateDate);

const uniqueId = generateId();
---

<a
  href={blogurl.with(post.id)}
  class:list={['card', 'link-card']}
  data-unique-id={uniqueId}
  data-enter-item
>
  <div class="wrapper">
    <div class="cover">
      {
        post.data.coverImage ? (
          <Image
            src={post.data.coverImage}
            alt={post.data.coverImageAlt ?? 'Cover Image'}
          />
        ) : (
          <div class="cover-placeholder" />
        )
      }
    </div>
    <div class="content">
      <Label class="title" style="font-size:20px;">{post.data.title}</Label>
      <div class="description">{description}</div>
      <TimeMeta
        icon={updated ? 'mdi:calendar-edit-outline' : 'mdi:calendar-outline'}
        time={displayDate}
      />
      <div class="tags-category-row">
        <TagsMeta tags={tags} />
        <CategoryBreadcrumb class="category" category={category} />
      </div>
    </div>
  </div>
</a>

<script>
  const transitionParts = ['cover', 'title', 'category'];

  // 同一个 view-transition-name 在文档里只能出现一次，重名会被浏览器整组忽略，
  // 因此每轮导航开始都要先还原上一轮挂上的名字，再决定这一轮挂给谁
  const namedElements = new Map<HTMLElement, string>();
  const applyTransitionName = (element: HTMLElement, name: string) => {
    if (!namedElements.has(element)) {
      namedElements.set(element, element.style.viewTransitionName);
    }
    element.style.viewTransitionName = name;
  };
  const restoreTransitionNames = () => {
    for (const [element, name] of namedElements) {
      element.style.viewTransitionName = name;
    }
    namedElements.clear();
  };

  // 被点击卡片的 uid，进入文章页后用它找回对应的封面/标题/分类
  let clickedCardUid: string | null = null;
  // 当前导航的取消信号：after-preparation 是普通 Event，只能靠 before-preparation 记下来
  let pendingNavigation: AbortSignal | undefined;

  const cardOfSource = (source: Element | undefined | null) => {
    // 卡片内的分类链接自行跳转，不算卡片整体点击
    if (!source || source.closest('.category-link')) {
      return null;
    }
    return source.closest('.card.link-card') as HTMLElement | null;
  };

  const cardOfUid = (root: ParentNode, uid: string) =>
    root.querySelector<HTMLElement>(`.card.link-card[data-unique-id="${uid}"]`);

  document.addEventListener('astro:before-preparation', (event) => {
    restoreTransitionNames();
    clickedCardUid = null;
    pendingNavigation = event.signal;

    const card = cardOfSource(event.sourceElement);
    if (!card) {
      return;
    }

    for (const part of transitionParts) {
      const elPart = card.querySelector<HTMLElement>(`.${part}`);
      if (elPart) {
        applyTransitionName(elPart, `clicked-${part}`);
      }
    }
    clickedCardUid = card.getAttribute('data-unique-id');
  });

  document.addEventListener('astro:after-preparation', () => {
    // 被抢占的旧导航不能在这一轮里继续挂名字
    if (pendingNavigation?.aborted || clickedCardUid) {
      return;
    }

    // 从文章页离开时列表页没有点击来源，改为由文章页留存的 uid 反查
    for (const part of transitionParts) {
      const transiteFrom = document.querySelector<HTMLElement>(
        `[data-transite-from-${part}]`,
      );
      if (!transiteFrom?.getAttribute(`data-transite-from-${part}`)) {
        continue;
      }

      applyTransitionName(transiteFrom, `clicked-${part}`);
    }
  });

  document.addEventListener('astro:before-swap', (event) => {
    if (clickedCardUid) {
      for (const part of transitionParts) {
        const transiteTo = event.newDocument.querySelector<HTMLElement>(
          `[data-transite-from-${part}]`,
        );
        if (!transiteTo) {
          continue;
        }

        // Save status
        transiteTo.setAttribute(`data-transite-from-${part}`, clickedCardUid);

        // Set view transition name for new cover element
        applyTransitionName(transiteTo, `clicked-${part}`);
      }

      clickedCardUid = null;
    } else {
      // Exit from inner page
      for (const part of transitionParts) {
        const transiteFrom = document.querySelector<HTMLElement>(
          `[data-transite-from-${part}]`,
        );
        const transiteId = transiteFrom?.getAttribute(
          `data-transite-from-${part}`,
        );
        if (!transiteId) {
          continue;
        }

        const transiteTo = cardOfUid(
          event.newDocument,
          transiteId,
        )?.querySelector<HTMLElement>(`.${part}`);
        if (!transiteTo) {
          continue;
        }

        applyTransitionName(transiteTo, `clicked-${part}`);
      }
    }

    // 还原必须等过渡结束：page-load 早于新快照捕获，提前还原会把新文档的名字擦掉
    event.viewTransition.finished.then(restoreTransitionNames);
  });
</script>

<style lang="stylus">
  .card.link-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-sans);
    position: relative;
    background-color: transparent;
    padding: 0;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    height: 100%;
    background-color: var(--secondary-container);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;

    > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .cover-placeholder {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      135deg,
      var(--primary-container),
      var(--secondary-container)
    );
  }

  .content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;

    .tags-category-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 8px;
    }
  }

  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    width: 100%;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
