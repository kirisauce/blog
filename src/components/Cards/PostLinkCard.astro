---
import type { CollectionEntry } from 'astro:content';
import { blogurl } from '../../utils/url';
import { generateId } from '../../utils/other';
import { Image } from 'astro:assets';
import CategoryBreadcrumb from '../MetaWidgets/CategoryBreadcrumb.astro';
import Label from '../Label.astro';
import TimeMeta from '../MetaWidgets/TimeMeta.astro';
import TagsMeta from '../MetaWidgets/TagsMeta.astro';

export interface Props {
  post: CollectionEntry<'blog'>;
  updateDate?: Date;
  pubDate?: Date;
  description?: string;
}

const { post, updateDate, pubDate, description } = Astro.props;
const { category, tags } = post.data;

const uniqueId = generateId();
---

<a
  href={blogurl.with(post.id)}
  class:list={['card', 'link-card']}
  data-unique-id={uniqueId}
>
  <div class="wrapper">
    <div class="cover">
      {
        post.data.coverImage ? (
          <Image
            src={post.data.coverImage}
            alt={post.data.coverImageAlt ?? 'Cover Image'}
          />
        ) : (
          <div class="cover-placeholder" />
        )
      }
    </div>
    <div class="content">
      <Label class="title" style="font-size:20px;">{post.data.title}</Label>
      <div class="description">{description}</div>
      <div class="time-row">
        <TimeMeta icon="mdi:calendar-edit-outline" time={updateDate} />
        <TimeMeta icon="mdi:calendar-outline" time={pubDate} />
      </div>
      <div class="tags-category-row">
        <TagsMeta tags={tags} />
        <CategoryBreadcrumb class="category" category={category} />
      </div>
    </div>
  </div>
</a>

<script>
  let clickedCardUid: string | null = null;
  const transitionParts = ['cover', 'title', 'category'];

  const restoreAfterTransition = new Map<HTMLElement, string>();
  const setRestore = (element: HTMLElement, value: string) => {
    if (!restoreAfterTransition.has(element)) {
      restoreAfterTransition.set(element, element.style.transform);
    }
  };
  const restore = () => {
    for (const [restoreElement, value] of restoreAfterTransition.entries()) {
      restoreElement.style.viewTransitionName = value;
    }
    restoreAfterTransition.clear();
  };

  document.addEventListener('click', (e) => {
    // 卡片内分类链接自行跳转，不算卡片整体点击
    if ((e.target as Element).closest('.category-link')) {
      return;
    }
    let el = (e.target as Element).closest('.card.link-card');
    if (!el) {
      return;
    }
    restoreAfterTransition.clear();

    for (const part of transitionParts) {
      const elPart = el.querySelector(`.${part}`) as HTMLElement | null;
      if (!elPart) {
        continue;
      }

      setRestore(elPart, elPart.style.viewTransitionName);
      elPart.style.viewTransitionName = `clicked-${part}`;
    }
    clickedCardUid = el.getAttribute('data-unique-id');
  });

  document.addEventListener('astro:after-preparation', () => {
    if (clickedCardUid) {
    } else {
      for (const part of transitionParts) {
        const transiteFrom = document.querySelector(
          `[data-transite-from-${part}]`,
        ) as HTMLElement | null;
        if (!transiteFrom) {
          continue;
        }

        const transiteId = transiteFrom.getAttribute(
          `data-transite-from-${part}`,
        );
        if (!transiteId) {
          continue;
        }

        setRestore(transiteFrom, transiteFrom.style.viewTransitionName);
        transiteFrom.style.viewTransitionName = `clicked-${part}`;
      }
    }
  });

  document.addEventListener('astro:before-swap', (e) => {
    if (clickedCardUid) {
      for (const part of transitionParts) {
        const transiteTo = e.newDocument.querySelector(
          `[data-transite-from-${part}]`,
        ) as HTMLElement | null;
        if (!transiteTo) {
          continue;
        }

        // Save status
        transiteTo.setAttribute(`data-transite-from-${part}`, clickedCardUid);

        // Set view transition name for new cover element
        setRestore(transiteTo, transiteTo.style.viewTransitionName);
        transiteTo.style.viewTransitionName = `clicked-${part}`;
      }

      e.viewTransition.finished.then(restore);

      clickedCardUid = null;
    } else {
      // Exit from inner page
      for (const part of transitionParts) {
        const transiteFrom = document.querySelector(
          `[data-transite-from-${part}]`,
        ) as HTMLElement | null;
        if (!transiteFrom) {
          continue;
        }

        const transiteId = transiteFrom.getAttribute(
          `data-transite-from-${part}`,
        );
        const transiteTo = e.newDocument.querySelector(
          `.card.link-card[data-unique-id="${transiteId}"] .${part}`,
        ) as HTMLElement | null;
        if (!transiteTo) {
          continue;
        }

        setRestore(transiteTo, transiteTo.style.viewTransitionName);
        transiteTo.style.viewTransitionName = `clicked-${part}`;

        e.viewTransition.finished.then(restore);
      }
    }
  });
</script>

<style lang="stylus">
  .card.link-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-sans);
    position: relative;
    background-color: transparent;
    padding: 0;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    height: 100%;
    background-color: var(--secondary-container);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;

    > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .cover-placeholder {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      135deg,
      var(--primary-container),
      var(--secondary-container)
    );
  }

  .content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;

    .time-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 8px;
      align-items: center;
    }

    .tags-category-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 8px;
    }
  }

  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    width: 100%;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
